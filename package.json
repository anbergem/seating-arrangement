{
  "name": "seating-arrangement",
  "displayName": "Seating Arrangement",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace app for Seating Arrangement.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "agent-native dev",
    "build": "agent-native build",
    "db:migrate": "node scripts/gen-migrations-manifest.mjs && node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:reset": "node --env-file-if-exists=.env scripts/reset-local.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "start": "agent-native start",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "agent-native typecheck",
    "agent-native:doctor": "agent-native doctor",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:config": "node scripts/check-config-hygiene.mjs",
    "test:unit": "vitest --run --passWithNoTests",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "playwright test && E2E_MEMBERSHIP_MODE=other playwright test",
    "test:e2e:full": "pnpm build && pnpm test:e2e",
    "eval": "node scripts/run-evals.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm agent-native:doctor && pnpm check:boundaries && pnpm check:config && pnpm test:unit && pnpm test:guards && pnpm guard:i18n",
    "action": "agent-native action",
    "test:guards": "node --test tests/guards/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "guard:i18n": "node scripts/check-i18n-catalogs.mjs",
    "lint:workflows": "github-actionlint .github/workflows/*.yml"
  },
