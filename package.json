  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.23.0",
  "agent-native": {
    "scaffold": {
      "template": "chat",
      "frameworkSkills": "default",
      "templateRef": "@agent-native/core@0.176.5",
      "templateSource": "bundled",
      "coreVersion": "0.176.5",
      "shape": "standalone"
    }
  }
