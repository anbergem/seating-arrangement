{
  "name": "agent-native-cloudflare-starter",
  "displayName": "Example Jobs",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace app for Example Jobs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "agent-native dev",
    "build": "agent-native build",
    "build:worker": "node scripts/build-worker.mjs",
    "dev:worker": "pnpm build:worker && pnpm dev:worker:serve",
    "dev:worker:serve": "wrangler dev --port 8787 --ip 127.0.0.1 --local",
    "db:migrate": "node scripts/gen-migrations-manifest.mjs && node scripts/migrate-local.mjs",
    "db:migrate:worker": "wrangler d1 migrations apply example-jobs-local --local",
    "db:reset": "node scripts/reset-local.mjs",
    "db:seed": "node scripts/seed.mjs --target node",
    "db:seed:worker": "node scripts/seed.mjs --target d1-local",
    "db:migrate:staging": "wrangler d1 migrations apply example-jobs-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply example-jobs-production --remote --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "backup:d1": "bash scripts/backup-d1.sh",
    "start": "agent-native start",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "agent-native typecheck",
    "agent-native:doctor": "agent-native doctor",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:config": "node scripts/check-config-hygiene.mjs",
    "test:unit": "vitest --run --passWithNoTests",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:full": "pnpm build:worker && playwright test",
    "eval": "node scripts/run-evals.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm agent-native:doctor && pnpm check:boundaries && pnpm check:config && pnpm test:unit && pnpm test:guards && pnpm guard:i18n",
    "action": "agent-native action",
    "test:guards": "node --test tests/guards/*.test.mjs",
    "smoke": "node scripts/worker-smoke.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "guard:i18n": "node scripts/check-i18n-catalogs.mjs",
    "lint:workflows": "github-actionlint .github/workflows/*.yml"
  },
  "dependencies": {
    "@agent-native/core": "0.176.5",
    "@agent-native/toolkit": "0.19.3",
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/cohere": "^3.0.39",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/groq": "^3.0.35",
    "@ai-sdk/mistral": "^3.0.40",
    "@ai-sdk/openai": "^3.0.53",
    "@fontsource-variable/inter": "^5.2.8",
    "@libsql/client": "^0.15.8",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@react-router/dev": "8.1.0",
    "@react-router/fs-routes": "8.1.0",
    "@tabler/icons-react": "^3.41.1",
    "ai": "6.0.258",
    "ai-sdk-ollama": "^3.8.8",
    "h3": "^2.0.1-rc.20",
    "isbot": "^5",
    "node-pty": "^1.1.0",
    "postgres": "^3.4.9",
    "react-router": "8.1.0",
    "vite": "8.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.99.2",
    "@types/node": "^24.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "github-actionlint": "1.7.12",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.5",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.23.0",
  "agent-native": {
    "scaffold": {
      "template": "chat",
      "frameworkSkills": "default",
      "templateRef": "@agent-native/core@0.176.5",
      "templateSource": "bundled",
      "coreVersion": "0.176.5",
      "shape": "standalone"
    }
  }
}
