# Node dev server (`pnpm dev`). Copy to `.env`, which is git-ignored.
# Names only: never commit a real value. See docs/plan/03-blueprint.md B13.

APP_ENV=local
# PostgreSQL on this machine (docs/database-and-migrations.md has the one-time install).
# `pnpm db:migrate` creates the database on first use. Without a local PostgreSQL,
# `pglite:./data/pglite` runs PostgreSQL inside the dev server instead — but then stop
# `pnpm dev` before `pnpm db:seed`, because PGlite allows one process at a time.
DATABASE_URL=postgres://localhost:5432/seating-arrangement-dev
APP_URL=http://localhost:8080

# 32 characters or more. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

AUTO_CREATE_DEFAULT_ORG=0
AGENT_NATIVE_DISABLE_AUTO_DEV_ACCOUNT=1
AUTH_REQUIRE_EMAIL_VERIFICATION=0

SEED_ENABLED=1
SEED_PASSWORD=Example-Seed-Password-2026

# Optional, and local only: the agent chat and the evals use it on this machine. A deployed
# application ignores it — each organization saves its own key in Settings › Model (D31).
ANTHROPIC_API_KEY=
