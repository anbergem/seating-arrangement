# Input for `node scripts/bootstrap.mjs` (docs/bootstrap.md, decision D28).
#
# Copy to `.bootstrap.env`, which is git-ignored, and fill in the values:
#
#   cp .bootstrap.env.example .bootstrap.env
#   node scripts/bootstrap.mjs --plan          # read-only: prints what it would do
#   node scripts/bootstrap.mjs --yes           # performs it
#
# Names only in this file: never commit a value. The script reads nothing from its own
# command line, so no secret ever reaches your shell history. Any key left empty here can
# also be supplied through the process environment instead.
#
# Delete `.bootstrap.env` once the setup is done. The signing secrets the script generates
# are never written to any file.

# ---------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------

# Kebab-case application name. Must equal the top-level "name" in wrangler.jsonc, which is
# `example-jobs` until `node scripts/rename-app.mjs` has been run. Databases and Workers are
# named `<APP_NAME>-staging` and `<APP_NAME>-production`.
APP_NAME=

# GitHub repository as `owner/name`.
GITHUB_REPO=

# Public origins, https, no trailing slash. These become the GitHub environment variables
# `STAGING_URL` / `PRODUCTION_URL` and the Worker var `APP_URL` per environment.
STAGING_URL=
PRODUCTION_URL=

# Cloudflare account id (Workers & Pages -> Account details).
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with the "Edit Cloudflare Workers" template plus D1:Edit. Used by
# `wrangler` through the child environment and stored as a GitHub environment secret.
CLOUDFLARE_API_TOKEN=

# Google OAuth client for sign-in (identity scopes only).
GOOGLE_SIGN_IN_CLIENT_ID=
GOOGLE_SIGN_IN_CLIENT_SECRET=

# Anthropic key for the embedded agent (decision D15).
ANTHROPIC_API_KEY=

# Password for the staging QA accounts. 16 characters or more. Staging only: production is
# never seeded.
SEED_PASSWORD=

# ---------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------

# Comma-separated GitHub logins who may approve a production promotion. Without at least one,
# the script refuses to create the `production` environment unless
# `--allow-unprotected-production` is given.
PRODUCTION_REVIEWERS=

# Set to 1 to mark the repository as a GitHub template repository.
TEMPLATE_REPOSITORY=

# Backup destination (docs/backups.md). Leave empty to keep the nightly export as a
# 30-day GitHub artifact instead of uploading it. Stored in the `production-backup`
# environment.
BACKUP_AGE_RECIPIENT=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=
