# Input for `node scripts/bootstrap.mjs` (docs/bootstrap.md, decisions D28, D29).
#
# Copy to `.bootstrap.env`, which is git-ignored, and fill in the values:
#
#   cp .bootstrap.env.example .bootstrap.env
#   clever login                               # once, opens a browser
#   node scripts/bootstrap.mjs --plan          # read-only: prints what it would do
#   node scripts/bootstrap.mjs --yes           # performs it
#
# Names only in this file: never commit a value. The script reads nothing from its own
# command line, so no secret ever reaches your shell history. Any key left empty here can
# also be supplied through the process environment instead.
#
# There is no Clever Cloud credential here on purpose. `clever login` stores a profile in
# ~/.config/clever-cloud/, and the script reads it from there — for its own calls and to
# set the two GitHub secrets CI deploys with. One less secret in one less place.
#
# Delete `.bootstrap.env` once the setup is done. The signing secrets the script generates
# are never written to any file.

# ---------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------

# Kebab-case application name. Must equal "name" in package.json, which is `example-jobs`
# until `node scripts/rename-app.mjs` has been run. Applications and their databases are
# named `<APP_NAME>-staging`, `<APP_NAME>-staging-db`, and the same for production.
APP_NAME=

# GitHub repository as `owner/name`.
GITHUB_REPO=

# Google OAuth client for sign-in (identity scopes only). The redirect URIs it needs
# contain the application URLs, which Clever Cloud assigns when it creates them — so this
# client is usually finished after the first bootstrap run, not before it.
GOOGLE_SIGN_IN_CLIENT_ID=
GOOGLE_SIGN_IN_CLIENT_SECRET=

# Anthropic key for the embedded agent (decision D15).
ANTHROPIC_API_KEY=

# Password for the staging QA accounts. 16 characters or more. Staging only: production is
# never seeded.
SEED_PASSWORD=

# ---------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------

# Custom domains, https, no trailing slash. Leave empty and each application answers on the
# `cleverapps.io` name Clever Cloud assigns, which bootstrap reads back and uses for
# APP_URL and for the GitHub environment variables. Set these only if you already own a
# domain and have pointed it at the application.
STAGING_URL=
PRODUCTION_URL=

# Clever Cloud organisation to create the applications in. Empty uses your personal one.
CLEVER_ORG=

# Zone for applications and databases. Default `par` (Paris). European: par, parhds, rbx,
# rbxhds, grahds, wsw, ldn. Elsewhere: scw, mtl, sgp, syd. `parhds` and `grahds` are the
# French health-data-certified zones.
CLEVER_REGION=

# PostgreSQL plan. Default `xxs_sml`, which is the smallest that works: the free `dev` plan
# allows five connections and the framework opens a pool of twenty with no way to configure
# it down, so `dev` cannot run this application at all. Larger: xs_sml, s_sml, m_sml.
POSTGRES_PLAN=

# Comma-separated GitHub logins who may approve a production promotion. Without at least one,
# the script refuses to create the `production` environment unless
# `--allow-unprotected-production` is given.
PRODUCTION_REVIEWERS=

# Set to 1 to mark the repository as a GitHub template repository.
TEMPLATE_REPOSITORY=
